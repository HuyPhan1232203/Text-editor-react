# Optional PDF export backend (PDF-export-Puppeteer).
# Leave unset to export PDF with the browser print dialog.
# VITE_PDF_API_URL=http://localhost:3000

# Optional signaling servers for sharing (comma-separated). Defaults to the public
# y-webrtc server; run your own with: PORT=4444 npx -p y-webrtc y-webrtc-signaling
# VITE_SIGNALING_URLS=wss://signaling.example.com
